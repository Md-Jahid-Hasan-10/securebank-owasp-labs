# VULN: [A02-Lab6] Sensitive File Exposure - this file is served verbatim from the web
# root. Every value below is FAKE and exists only for the training labs, but the file
# demonstrates exactly what an exposed .env hands to an attacker.
#
# FIX:  never place a .env in a directory served by the web server. Add it to
#       .gitignore and load configuration from the environment or a secret manager.

APP_ENV=development
APP_DEBUG=true
APP_SECRET=dev-only-do-not-ship

# VULN: [A04-Lab8] The JWT signing secret is also committed here, matching the value in
# application.yml. Either leak is enough to forge an admin token.
JWT_SECRET=secret

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=securebank
POSTGRES_USER=securebank
POSTGRES_PASSWORD=securebank

# FAKE cloud credentials - not real, and not usable anywhere.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=eu-west-2

