<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.securebank</groupId>
    <artifactId>securebank-labs-backend</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>core</artifactId>
  <name>SecureBank Labs Core</name>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!--
      NOTE: spring-boot-starter-security is deliberately NOT included.
      Spring Security auto-configuration would silently remediate Labs 1, 2, 15, 18, 21 and 25.
      Authentication is hand-rolled in com.securebank.core.security so that every
      flaw is explicit and greppable via the "VULN:" comment convention.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <!--
      VULN: [A08-Lab20] Insecure Deserialization - commons-collections 3.2.1 provides the
      InvokerTransformer gadget chain used by Lab 20's Jackson polymorphic deserialization RCE.
      FIX:  remove this dependency and never enable default typing on untrusted input.
    -->
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!--
        FIXED: [A02-Lab6] Sensitive File Exposure - the static resource directory is
        no longer packaged into the artifact as-is. It used to include the .env
        file, so the environment file shipped inside the deployable jar and was
        served over HTTP by the static resource handler.

        The static tree now only contains the uploads directory (Lab 22) and the
        assets directory. Secrets and VCS metadata are never packaged into an
        artifact.
      -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>static/**</exclude>
          <exclude>lab-fixtures/**</exclude>
        </excludes>
      </resource>
      <!--
        The static tree is packaged separately so that the asset and upload
        directories are still present in the artifact, but without any secret
        file that may have been dropped into them.
      -->
      <resource>
        <directory>src/main/resources/static</directory>
        <targetPath>static</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>assets/**</include>
          <include>uploads/**</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            FIXED: [A02-Lab6] the .git directory is no longer kept in the artifact,
            so it can no longer be downloaded over HTTP.
          -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
