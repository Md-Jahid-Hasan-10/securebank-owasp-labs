# --- SecureBank Labs specific -----------------------------------------------

# The one-off commit/push helper scripts are written per task and then used
# once. Tracking them would mean a commit for every helper.
scripts/do-commit-*.sh
scripts/do-push-*.sh

# Lab 6: the database dump is generated at container start, never committed.
backend/core/src/main/resources/static/backup.zip
*.dump

# Lab 22: uploaded files are written at runtime, never committed.
backend/core/src/main/resources/static/uploads/*
!backend/core/src/main/resources/static/uploads/.gitkeep

# Generated by scripts/sync-labs.py from labs/labs.meta.yaml + the Java sources.
# Regenerate with: python3 scripts/sync-labs.py
backend/core/src/main/resources/labs/labs.json

# NOTE: the Lab 6 fixture (a fake .git directory) is NOT stored at
# backend/core/src/main/resources/static/.git/ - git refuses to track any path
# containing a ".git" component, even with "git add -f" or "git update-index".
# It lives at backend/core/src/main/resources/lab-fixtures/git-config instead, and
# the Dockerfile renames it to /app/static/.git/config inside the image, so the
# served path is still /.git/config.
